# Managed by HAXcms. Prevent execution of uploaded scripts in /files.
Options -ExecCGI
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
# Security (SEC-UPLOAD): uploaded browser-renderable markup (html, htm, xhtml,
# xml, svg; case-insensitive, same list as the HAXcms root .htaccess and
# haxcms-nodejs) is always downloaded, never rendered inline in the site
# origin. FilesMatch tests the name of the file actually being served from
# this directory tree, so URL encodings (x%2ehtml, %66iles/) cannot bypass it,
# and it still applies when the site is served from its own vhost/docroot
# where the HAXcms root .htaccess is not a parent directory.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(html?|xhtml|xml|svg)$">
    Header always set Content-Disposition "attachment"
    Header always set X-Content-Type-Options nosniff
  </FilesMatch>
</IfModule>
# Uploaded content encoding is not guaranteed; don't inherit the UTF-8
# charset tagging applied at the site root to generated/managed files.
<IfModule mod_mime.c>
  RemoveCharset .txt .md .json .yaml .yml .xml
</IfModule>
