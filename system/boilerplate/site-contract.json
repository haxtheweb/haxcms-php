{
  "$schema": "./site-contract.schema.json",
  "title": "HAXcms site folder contract",
  "description": "Every path a HAXcms site folder may hold: whether it is required, who owns it, and which schema it follows. site.json itself is described by haxcms-site.schema.json; this file describes the folder around it. Tools check a folder against it with `jos-validate --site <dir>`. haxcms-nodejs and haxcms-php each carry an identical copy and fail their tests when their boilerplate or managed-file list disagrees with it, so adding or dropping a site file is a deliberate edit here.",
  "levels": [
    {
      "id": "content",
      "title": "Content",
      "description": "A valid site.json and a file at every item's location. Portable content any engine can read; what an exporter from another system targets."
    },
    {
      "id": "runnable",
      "title": "Runnable",
      "description": "Content plus the loader files, so the folder serves as a site from a static host."
    },
    {
      "id": "managed",
      "title": "Managed",
      "description": "Runnable plus every file a HAXcms backend writes and rebuilds, so a backend can take the folder over without a first-save rewrite."
    }
  ],
  "ignore": [
    ".git",
    "node_modules"
  ],
  "entries": [
    {
      "path": "site.json",
      "status": "required",
      "owner": "authored",
      "level": "content",
      "boilerplate": true,
      "schema": "haxcms-site.schema.json",
      "note": "The manifest: site metadata and the page outline (JSON Outline Schema). The single source of truth for structure."
    },
    {
      "path": "pages/*/index.html",
      "status": "required",
      "owner": "authored",
      "level": "content",
      "rule": "item-location",
      "note": "Page content. Required for every item in site.json: the file at the item's location must exist (HAXcms writes pages/<id>/index.html)."
    },
    {
      "path": "pages/*/index.*",
      "status": "optional",
      "owner": "generated",
      "note": "Alternate formats of a page (md, json, yaml, xml), rebuilt from index.html when content is saved through HAX tooling."
    },
    {
      "path": "pages/.gitkeep",
      "status": "optional",
      "owner": "scaffold",
      "boilerplate": true,
      "note": "Keeps pages/ in git before the first page exists."
    },
    {
      "path": "pages/**",
      "status": "optional",
      "owner": "authored",
      "note": "Anything else an author keeps beside a page."
    },
    {
      "path": "files/.htaccess",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Stops uploaded files from executing on Apache hosts."
    },
    {
      "path": "files/files.json",
      "status": "optional",
      "owner": "generated",
      "boilerplate": true,
      "note": "Index of uploaded files kept by the backends."
    },
    {
      "path": "files/.gitkeep",
      "status": "optional",
      "owner": "scaffold",
      "boilerplate": true,
      "note": "Keeps files/ in git before the first upload."
    },
    {
      "path": "files/**",
      "status": "optional",
      "owner": "authored",
      "note": "Uploads and other static assets the content links to."
    },
    {
      "path": "index.html",
      "status": "required",
      "owner": "managed",
      "level": "runnable",
      "boilerplate": true,
      "policy": "replace",
      "note": "The site shell every route loads; static fallback when no backend renders the page."
    },
    {
      "path": "build.js",
      "status": "required",
      "owner": "managed",
      "level": "runnable",
      "boilerplate": true,
      "policy": "replace",
      "note": "Loader (the magic script) that finds the web component build on a CDN or beside the site."
    },
    {
      "path": "build-haxcms.js",
      "status": "required",
      "owner": "managed",
      "level": "runnable",
      "boilerplate": true,
      "policy": "replace",
      "note": "Loads the HAXcms site builder once build.js has resolved where assets live."
    },
    {
      "path": "404.html",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Static-host fallback that redirects unknown paths back into the site router."
    },
    {
      "path": "ghpages.html",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Site shell variant used when publishing to GitHub Pages."
    },
    {
      "path": "offline.html",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Page the service worker shows offline."
    },
    {
      "path": "manifest.json",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Web app manifest."
    },
    {
      "path": "service-worker.js",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Service worker for offline use."
    },
    {
      "path": "push-manifest.json",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Preload hints for the site shell."
    },
    {
      "path": "browserconfig.xml",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Windows tile settings."
    },
    {
      "path": "assets/upgrade-browser.html",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Shown to browsers too old to run the site."
    },
    {
