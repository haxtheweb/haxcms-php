      "note": "API catalog (RFC 9727) for agents and tools."
    },
    {
      "path": "web-dev-server.haxcms.config.cjs",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "Local development server settings."
    },
    {
      "path": "imsmanifest.xml",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "SCORM 1.2 package manifest."
    },
    {
      "path": "imsmd_rootv1p2p1.xsd",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "SCORM 1.2 schema."
    },
    {
      "path": "imscp_rootv1p1p2.xsd",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "SCORM 1.2 schema."
    },
    {
      "path": "adlcp_rootv1p2.xsd",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "SCORM 1.2 schema."
    },
    {
      "path": "ims_xml.xsd",
      "status": "required",
      "owner": "managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "replace",
      "note": "SCORM 1.2 schema."
    },
    {
      "path": ".htaccess",
      "status": "required",
      "owner": "partly-managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "block",
      "note": "Apache rules. HAXcms owns the block between its markers; the rest is the site owner's."
    },
    {
      "path": "robots.txt",
      "status": "required",
      "owner": "partly-managed",
      "level": "managed",
      "boilerplate": true,
      "policy": "block",
